<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Quora Posts</h1>

    <button><a href="http://localhost:8080/posts/new">Create new Post</a></button>


    <% for(post of posts) { %>
        <div class="post">
            <h3 class="user">@ <%=post.username %></h3>
            <h4 class="content"><%= post.content %></h4>

            <button><a href="http://localhost:8080/posts/<%=post.id%>">See details</a></button>
            <button><a href="http://localhost:8080/posts/<%=post.id%>/edit">Edit Content</a></button><br><br>

            <form method="post" action="/posts/<%= post.id%>?_method=DELETE">
                <button>Delete Posts</button>
            </form>
            

        </div><br>


     <% } %>

</body>
</html>